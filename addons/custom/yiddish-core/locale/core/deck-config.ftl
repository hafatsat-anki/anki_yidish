deck-config-used-by-decks =
    גענוצט דורך { $decks ->
        [one] { $decks } פעקל
       *[other] { $decks } פעקלעך
    }
deck-config-default-name = ברירת מחדל
deck-config-title = פעקל־אפציעס
deck-config-daily-limits = טעגליכע גרענעצן
deck-config-new-limit-tooltip =
    די גרעסטע צאל נייע קארטלעך צו לערנען אין איין טאג, ווען עס זענען דא נייע קארטלעך.
    נייע חומר פארגרעסערט די חזרות אין דער נאענטער צייט.
    דעריבער זאל די גרענעץ געווענליך זיין כאטש 10 מאל קלענער פון דער חזרה־גרענעץ.
deck-config-review-limit-tooltip = די גרעסטע צאל חזרה־קארטלעך צו ווייזן אין איין טאג, ווען קארטלעך זענען גרייט צו חזרה.
deck-config-limit-deck-v3 =
    ווען איר לערנט א פעקל מיט אונטערפעקלעך, באשטימט די גרענעץ פון יעדן אונטערפעקל
    וויפיל קארטלעך מען נעמט פון יענעם פעקל. די גרענעץ פונעם אויסגעקליבענעם פעקל
    באשטימט די גאנצע צאל קארטלעך וואס ווערן געוויזן.
deck-config-limit-new-bound-by-reviews =
    די חזרה־גרענעץ ווירקט אויף דער גרענעץ פאר נייע קארטלעך. למשל, ביי א חזרה־גרענעץ
    פון 200 מיט 190 ווארטנדיגע חזרות, ווערן ביז 10 נייע קארטלעך געוויזן.
    ווען מען דערגרייכט די חזרה־גרענעץ, ווערן נישט געוויזן קיין נייע קארטלעך.
deck-config-limit-interday-bound-by-reviews =
    די חזרה־גרענעץ ווירקט אויך אויף לערן־קארטלעך פון פריערדיגע טעג.
    ביים אנווענדן די גרענעץ נעמט מען ערשט די לערן־קארטלעך, און דערנאך די חזרה־קארטלעך.
deck-config-tab-description =
    - `פאראיינשטעלונג`: די גרענעץ גילט פאר אלע פעקלעך וואס נוצן די פאראיינשטעלונג.
    - `דער פעקל`: די גרענעץ גילט נאר פאר דעם פעקל.
    - `נאר היינט`: א צייטווייליגער טויש אין דער גרענעץ פונעם פעקל.
deck-config-new-cards-ignore-review-limit = נייע קארטלעך איגנארירן די חזרה־גרענעץ
deck-config-new-cards-ignore-review-limit-tooltip =
    אלס ברירת מחדל גילט די חזרה־גרענעץ אויך פאר נייע קארטלעך.
    ווען די גרענעץ ווערט דערגרייכט, ווערן קיין נייע קארטלעך נישט געוויזן.
    מיט דער אפציע ווערן נייע קארטלעך געוויזן אומאפהענגיג פון דער חזרה־גרענעץ.
deck-config-apply-all-parent-limits = גרענעצן הייבן זיך אן פון אויבן
deck-config-apply-all-parent-limits-tooltip =
    אלס ברירת מחדל גילטן די טעגליכע גרענעצן פונעם הויפטפעקל נישט ווען מען לערנט פון אן אונטערפעקל.
    מיט דער אפציע הייבן זיך די גרענעצן אן פונעם אויבערשטן פעקל.
    דאס איז נוצליך צו לערנען באזונדערע אונטערפעקלעך און דאך האלטן א גאנצע גרענעץ פארן פעקל־בוים.
deck-config-affects-entire-collection = ווירקט אויף דער גאנצער זאמלונג.
deck-config-shared-preset = פאראיינשטעלונג
deck-config-deck-only = דער פעקל
deck-config-today-only = נאר היינט
deck-config-learning-steps = לערן־טריט
-deck-config-delay-hint = אפשטאנדן זענען געווענליך מינוטן (למשל `1m`) אדער טעג (למשל `2d`), אבער אויך שעה'ן (למשל `1h`) און סעקונדעס (למשל `30s`) ווערן געשטיצט.
deck-config-learning-steps-tooltip =
    איין אדער מער אפשטאנדן, אפגעטיילט מיט רווחים. דער ערשטער אפשטאנד ווערט גענוצט
    ווען איר דריקט `נאכאמאל` אויף א נייעם קארטל, און איז אלס ברירת מחדל 1 מינוט.
    `גוט` גייט ווייטער צום קומענדיגן טריט, וואס איז אלס ברירת מחדל 10 מינוטן.
    נאכן ענדיגן אלע טריט ווערט דער קארטל א חזרה־קארטל און ערשיינט אויף אן אנדער טאג.
    { -deck-config-delay-hint }
deck-config-graduating-interval-tooltip = די צאל טעג צו ווארטן ביזן נאכאמאל ווייזן א קארטל, נאכן דריקן `גוט` אויפן לעצטן לערן־טריט.
deck-config-easy-interval-tooltip = די צאל טעג צו ווארטן ביזן נאכאמאל ווייזן א קארטל, נאכן דריקן `גרינג` צו אים גלייך ארויסנעמען פון לערנען.
deck-config-new-insertion-order = סדר פון אריינלייגן
deck-config-new-insertion-order-tooltip =
    באשטימט דעם פלאץ (רייע־נומער) וואס נייע קארטלעך באקומען ביים צולייגן.
    קארטלעך מיט א קלענערן רייע־נומער ווערן געוויזן פריער ביים לערנען.
    טוישן די אפציע וועט אויטאמאטיש דערהיינטיגן די פארהאנענע פלעצער פון נייע קארטלעך.
deck-config-new-insertion-order-sequential = לויטן סדר (עלטערע קארטלעך צום ערשט)
deck-config-new-insertion-order-random = צופעליג
deck-config-new-insertion-order-random-with-v3 = מיטן V3 חזרה־פלאנירער איז בעסער צו לאזן לויטן סדר, און אנשטאט טוישן דעם סדר פון נעמען נייע קארטלעך.
deck-config-relearning-steps = איבערלערן־טריט
deck-config-relearning-steps-tooltip =
    נול אדער מער אפשטאנדן, אפגעטיילט מיט רווחים. אלס ברירת מחדל ווייזט `נאכאמאל`
    אויף א חזרה־קארטל אים נאכאמאל 10 מינוטן שפעטער. אן באשטימטע אפשטאנדן
    ווערט נאר דער אפשטאנד געענדערט, אן אריינגיין אין איבערלערנען.
    { -deck-config-delay-hint }
deck-config-leech-threshold-tooltip =
    די צאל מאל וואס מען דארף דריקן `נאכאמאל` אויף א חזרה־קארטל איידער ער ווערט אנגעצייכנט אלס אפט־פארגעסן.
    אזעלכע קארטלעך נעמען אסאך צייט. עס איז ראטזאם זיי איבערצושרייבן, אויסצומעקן,
    אדער אויסטראכטן א סימן וואס וועט העלפן זיי געדענקען.
deck-config-leech-action-tooltip =
    `נאר צולייגן א צעטל`: צולייגן דעם 'leech'־צעטל צו דער רשומה און ווייזן א הודעה.
    
    `אפשטעלן קארטל`: אויסער דעם צעטל, באהאלטן דעם קארטל ביז מען הייבט אויף די אפשטעלונג מיט דער האנט.
deck-config-bury-title = באזייטיגן ביז מארגן
deck-config-bury-new-siblings = באזייטיגן פארבונדענע נייע קארטלעך
deck-config-bury-review-siblings = באזייטיגן פארבונדענע חזרה־קארטלעך
deck-config-bury-interday-learning-siblings = באזייטיגן פארבונדענע לערן־קארטלעך פון פריערדיגע טעג
deck-config-bury-new-tooltip = צי אנדערע `נייע` קארטלעך פון דער זעלבער רשומה (ווי פארקערטע קארטלעך אדער שכינות'דיגע אויסגעלאזטע ווערטער) זאלן אפגעלייגט ווערן ביז מארגן.
deck-config-bury-review-tooltip = צי אנדערע `חזרה`־קארטלעך פון דער זעלבער רשומה זאלן אפגעלייגט ווערן ביז מארגן.
deck-config-bury-interday-learning-tooltip = צי אנדערע `לערן`־קארטלעך פון דער זעלבער רשומה מיט אפשטאנדן > 1 טאג זאלן אפגעלייגט ווערן ביז מארגן.
deck-config-bury-priority-tooltip =
    אנקי נעמט ערשט לערן־קארטלעך פונעם זעלבן טאג, דערנאך לערן־קארטלעך פון פריערדיגע טעג,
    דערנאך חזרה־קארטלעך, און צום סוף נייע קארטלעך. דאס ווירקט אויף באזייטיגן:
    
    - מיט אלע באזייטיג־אפציעס איינגעשאלטן, ווערט געוויזן דער פארבונדענער קארטל וואס קומט פריער אין דער ליסטע.
    למשל, א חזרה־קארטל ווערט געוויזן פאר א נייעם קארטל.
    - שפעטערדיגע סארטן אין דער ליסטע קענען נישט באזייטיגן פריערדיגע.
    למשל, אויב באזייטיגן נייע קארטלעך איז אויסגעשאלטן, וועט לערנען א נייעם קארטל נישט באזייטיגן
    לערן־קארטלעך פון פריערדיגע טעג אדער חזרה־קארטלעך. מען קען זען ביידע אין דער זעלבער לערן־רונדע.
deck-config-ordering-title = סדר פון ווייזן
deck-config-new-gather-priority = סדר פון נעמען נייע קארטלעך
deck-config-new-gather-priority-tooltip-2 =
    `פעקל`: נעמען קארטלעך פון יעדן אונטערפעקל לויטן סדר פון אויבן. אין יעדן אונטערפעקל נעמט מען
    קארטלעך פון קלענערע צו גרעסערע רייע־נומערן. ווען די טעגליכע גרענעץ ווערט דערגרייכט,
    קען מען אויפהערן איידער אלע אונטערפעקלעך ווערן קאנטראלירט.
    דער סדר איז דער שנעלסטער אין גרויסע זאמלונגען און גיט קדימה צו אונטערפעקלעך וואס זענען נענטער צום אויבן.
    
    `פון נידריגן צו הויכן פלאץ`: נעמען קארטלעך לויטן רייע־נומער, געווענליך עלטער־צוגעלייגטע צום ערשט.
    
    `פון הויכן צו נידריגן פלאץ`: נעמען קארטלעך לויטן רייע־נומער פארקערט, געווענליך ניי־צוגעלייגטע צום ערשט.
    
    `צופעליגע רשומות`: אויסקלייבן רשומות צופעליג און דערנאך נעמען אלע זייערע קארטלעך.
    
    `צופעליגע קארטלעך`: נעמען קארטלעך אין א צופעליגן סדר.
deck-config-new-card-sort-order = סארטיר־סדר פאר נייע קארטלעך
deck-config-new-card-sort-order-tooltip-2 =
    `סארט קארטל, דערנאך סדר פון נעמען`: ווייזן קארטלעך לויטן סארט־נומער,
    און אין יעדן סארט לויטן סדר ווי מען האט זיי גענומען. אן באזייטיגן פארבונדענע קארטלעך,
    ווערן אלע פארנט→הינטן קארטלעך געוויזן פאר אלע הינטן→פארנט קארטלעך.
    אזוי קען מען זען אלע קארטלעך פון דער זעלבער רשומה אין איין רונדע, אבער נישט צו נאענט איינס צום צווייטן.
    
    `סדר פון נעמען`: ווייזן קארטלעך פונקט ווי מען האט זיי גענומען.
    אן באזייטיגן פארבונדענע קארטלעך ווערן געווענליך אלע קארטלעך פון א רשומה געוויזן נאכאנאנד.
    
    `סארט קארטל, דערנאך צופעליג`: ווייזן לויטן סארט־נומער, און אין יעדן סארט צופעליג.
    דאס איז נוצליך ווען איר ווילט א צופעליגן סדר, אבער נישט אז פארבונדענע קארטלעך זאלן זיין צו נאענט.
    
    `צופעליגע רשומה, דערנאך סארט קארטל`: אויסקלייבן רשומות צופעליג און ווייזן זייערע קארטלעך לויטן סדר.
    
    `צופעליג`: ווייזן קארטלעך אין א צופעליגן סדר.
deck-config-new-review-priority = סדר פון נייע קארטלעך/חזרות
deck-config-new-review-priority-tooltip = ווען צו ווייזן נייע קארטלעך אין פארהעלטעניש צו חזרה־קארטלעך.
deck-config-interday-step-priority = סדר פון לערנען פון פריערדיגע טעג/חזרות
deck-config-interday-step-priority-tooltip =
    ווען צו ווייזן לערן־ אדער איבערלערן־קארטלעך וואס גייען אריבער די טאג־גרענעץ.
    
    די חזרה־גרענעץ ווערט שטענדיג קודם אנגעווענדט אויף די לערן־קארטלעך, און דערנאך אויף חזרה־קארטלעך.
    די אפציע באשטימט דעם סדר פון ווייזן די גענומענע קארטלעך, אבער די לערן־קארטלעך ווערן שטענדיג קודם גענומען.
deck-config-review-sort-order = סארטיר־סדר פאר חזרות
deck-config-review-sort-order-tooltip =
    דער געווענליכער סדר גיט קדימה צו קארטלעך וואס ווארטן דאס לענגסטע.
    אויב איר האט פארשפעטיגטע חזרות, ערשיינען די לענגסט־ווארטנדיגע צום ערשט.
    ביי א גרויסן חזרה־חוב וואס נעמט עטליכע טעג, אדער אויב איר ווילט דעם אונטערפעקלעך־סדר,
