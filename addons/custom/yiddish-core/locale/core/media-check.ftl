media-check-window-title = קאנטראלירן מעדיע
media-check-trash-count =
    מיסט־תיקיה: { $count ->
        [one] { $count } טעקע, { $megs }MB
       *[other] { $count } טעקעס, { $megs }MB
    }
media-check-missing-count = פעלנדע טעקעס: { $count }
media-check-unused-count = נישט־גענוצטע טעקעס: { $count }
media-check-renamed-count = טעקעס מיט געענדערטע נעמען: { $count }
media-check-oversize-count = איבער 100MB: { $count }
media-check-subfolder-count = אונטערתיקיות: { $count }
media-check-extracted-count = ארויסגענומענע בילדער: { $count }
media-check-renamed-header = די נעמען פון טייל טעקעס זענען געענדערט געווארן פאר צופאסונג:
media-check-oversize-header = טעקעס גרעסער פון 100MB קענען נישט סינכראניזירט ווערן מיט AnkiWeb.
media-check-subfolder-header = תיקיות אינערהאלב דער מעדיע־תיקיה ווערן נישט געשטיצט.
media-check-missing-header = די פאלגנדע טעקעס ווערן גענוצט אויף קארטלעך, אבער זענען נישט געפונען געווארן אין דער מעדיע־תיקיה:
media-check-unused-header = די פאלגנדע טעקעס זענען געפונען געווארן אין דער מעדיע־תיקיה, אבער ווערן לכאורה נישט גענוצט אויף קיין קארטלעך:
media-check-template-references-field-header =
    אנקי קען נישט דערקענען גענוצטע טעקעס ווען איר נוצט { "{{Field}}" }־רעפערענצן אין מעדיע/LaTeX־טעגס.
    די מעדיע/LaTeX־טעגס זאלן אנשטאט ווערן אריינגעלייגט אין די באזונדערע רשומות.
    
    מוסטערן מיט רעפערענצן:
media-check-renamed-file = נאמען געענדערט: { $old } -> { $new }
media-check-oversize-file = איבער 100MB: { $filename }
media-check-subfolder-file = תיקיה: { $filename }
media-check-missing-file = פעלט: { $filename }
media-check-unused-file = נישט גענוצט: { $filename }
media-check-notetype-template = { $notetype }: { $card_type } ({ $side })
media-check-checked = קאנטראלירט { $count }...
media-check-delete-unused-confirm = אויסמעקן נישט־גענוצטע מעדיע?
media-check-files-remaining =
    { $count ->
        [one] { $count } טעקע
       *[other] { $count } טעקעס
    } זענען נאך איבער.
media-check-delete-unused-complete =
    { $count ->
        [one] { $count } טעקע
       *[other] { $count } טעקעס
    } אריבערגעפירט צום מיסט.
media-check-trash-emptied = די מיסט־תיקיה איז יעצט ליידיג.
media-check-trash-restored = די אויסגעמעקטע טעקעס זענען צוריקגעשטעלט געווארן אין דער מעדיע־תיקיה.
media-check-all-latex-rendered = אלע LaTeX־אינהאלטן זענען אויסגעמאלט געווארן.
media-check-delete-unused = אויסמעקן נישט־גענוצטע
media-check-render-latex = אויסמאלן LaTeX
media-check-empty-trash = אויסליידיגן מיסט
media-check-restore-trash = צוריקברענגען אויסגעמעקטע
media-check-check-media-action = קאנטראלירן מעדיע
media-check-missing-media-tag = פעלנדע־מעדיע
media-check-add-tag = אנצייכענען פעלנדע
