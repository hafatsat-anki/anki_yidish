search-invalid-search = אומגילטיגע זוכעניש: { $reason }
search-misplaced-and = מען האט געפונען `and`, אבער עס פארבינדט נישט צוויי זוך־טערמינען. צו זוכן דאס ווארט אליין, נעמט עס ארום מיט דאפלטע גענזפיסלעך: `"and"`.
search-misplaced-or = מען האט געפונען `or`, אבער עס פארבינדט נישט צוויי זוך־טערמינען. צו זוכן דאס ווארט אליין, נעמט עס ארום מיט דאפלטע גענזפיסלעך: `"or"`.
search-empty-group = מען האט געפונען א גרופע `(...)`, אבער צווישן די קלאמערן איז נישטא וואס צו זוכן. צו זוכן די קלאמערן אליין, נעמט זיי ארום מיט דאפלטע גענזפיסלעך: `"( )"`.
search-unopened-group = מען האט געפונען א פארמאכטע קלאמער `)`, אן אן אפענער קלאמער `(` פאר איר. צו זוכן `)` אליין, נעמט עס ארום מיט דאפלטע גענזפיסלעך אדער לייגט א פארקערטן שטריך פאר דעם: `")"` אדער `\)`.
search-unclosed-group = מען האט געפונען אן אפענע קלאמער `(`, אן א פארמאכטער קלאמער `)` נאך איר. צו זוכן `(` אליין, נעמט עס ארום מיט דאפלטע גענזפיסלעך אדער לייגט א פארקערטן שטריך פאר דעם: `"("` אדער `\(` .
search-empty-quote = מען האט געפונען דאפלטע גענזפיסלעך `""`, אבער צווישן זיי איז נישטא וואס צו זוכן. צו זוכן די גענזפיסלעך אליין, לייגט פאר זיי פארקערטע שטריכן: `\"\"`.
search-unclosed-quote = מען האט געפונען אן אפענעם גענזפיסל `"`, אן א צווייטן עס צו פארמאכן. צו זוכן `"` אליין, לייגט א פארקערטן שטריך פאר דעם: `\"`.
search-missing-key = מען האט געפונען א צווייפינטל `:`, אן א שליסלווארט פאר דעם. צו זוכן `:` אליין, לייגט א פארקערטן שטריך פאר דעם: `\:`.
search-unknown-escape = די אויסנאם־סעקווענץ `{ $val }` איז נישט באשטימט. צו זוכן א פארקערטן שטריך `\` אליין, לייגט צו נאך איינעם פאר דעם: `\\`.
search-invalid-argument = `{ $term }` האט באקומען אן אומגילטיגן ארגומענט '`{ $argument }`'.
search-invalid-flag-2 = נאך `flag:` דארף קומען א גילטיגער פענדל־נומער: `1` (רויט), `2` (אראנזש), `3` (גרין), `4` (בלוי), `5` (ראזע), `6` (טערקויז), `7` (לילא) אדער `0` (קיין פענדל).
search-invalid-prop-operator = נאך `prop:{ $val }` דארף קומען איינער פון די פארגלייך־צייכנס: `=`, `!=`, `<`, `>`, `<=` אדער `>=`.
search-invalid-other = ביטע קאנטראלירט צי עס זענען נישטא קיין שרייב־טעותים.
search-invalid-number = אין "`{ $context }`" דארף זיין א נומער, אבער מען האט געפונען "`{ $provided }`".
search-invalid-whole-number = אין "`{ $context }`" דארף זיין א גאנצער נומער, אבער מען האט געפונען "`{ $provided }`".
search-invalid-positive-whole-number = אין "`{ $context }`" דארף זיין א פאזיטיווער גאנצער נומער, אבער מען האט געפונען "`{ $provided }`".
search-invalid-negative-whole-number = אין "`{ $context }`" דארף זיין א גאנצער נומער קלענער אדער גלייך צו 0, אבער מען האט געפונען "`{ $provided }`".
search-invalid-answer-button = אין "`{ $context }`" דארף זיין אן ענטפער־קנעפל פון 1-4, אבער מען האט געפונען "`{ $provided }`".
search-note-modified = רשומה געענדערט
search-card-modified = קארטל געענדערט
search-view-in-browser = זען אין דורכבלעטערן
